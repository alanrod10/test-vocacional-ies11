# ==============================================================================
# Variables de entorno - Test Vocacional IES N.° 11
# Copiar este archivo a .env y configurar los valores correspondientes.
# NUNCA subir archivos .env ni secretos reales al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Modo de Instancia
# ------------------------------------------------------------------------------
# Valores permitidos: 'permanent' (predeterminado) | 'historical'
# - permanent: Cuestionario habilitado, permite nuevas evaluaciones vocacionales.
# - historical: Modo archivo de la Expo Educativa 2026 (solo lectura y estadísticas).
INSTANCE_MODE=permanent
VITE_INSTANCE_MODE=permanent

# ------------------------------------------------------------------------------
# Base de Datos (MySQL)
# ------------------------------------------------------------------------------
# Formato: mysql://usuario:contraseña@servidor:puerto/nombre_base_datos
DATABASE_URL=mysql://usuario:password@localhost:3306/test_vocacional_ies11

# ------------------------------------------------------------------------------
# Seguridad y Administración
# ------------------------------------------------------------------------------
# Contraseña para acciones de coordinación (exportación de CSV y acciones protegidas)
ADMIN_ACTION_PASSWORD=cambiar_por_una_contrasena_segura

# Clave secreta para firma de tokens JWT y firmas HMAC
JWT_SECRET=cambiar_por_un_secreto_aleatorio_y_seguro

# ------------------------------------------------------------------------------
# Servidor y Entorno
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Analítica opcional (Umami)
# ------------------------------------------------------------------------------
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ------------------------------------------------------------------------------
# Variables de integración de plataforma (Opcionales / Manus / Forge)
# ------------------------------------------------------------------------------
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
