# ==============================================================================
# Variables de Entorno de Producción y Desarrollo — Test Vocacional IES N.° 11
# ==============================================================================
# Instrucciones de uso:
# 1. Copiar este archivo a '.env' en la raíz del proyecto:
#    cp .env.example .env
# 2. Configurar los valores específicos para su entorno (VPS institucional o local).
# 3. Restringir permisos de lectura en el servidor:
#    chmod 600 .env
# 4. NUNCA comitear ni compartir el archivo '.env' con secretos reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modo de Instancia y Archivo Histórico
# ------------------------------------------------------------------------------
# Define el comportamiento operativo del sistema:
# - 'permanent'  : (Predeterminado) Cuestionario activo, recibe nuevas evaluaciones
#                  y permite persistir resultados en la base de datos.
# - 'historical' : Modo archivo Expo Educativa 2026 (solo lectura y estadísticas).
#                  Bloquea nuevos envíos y reseteos para preservar la muestra histórica.
INSTANCE_MODE=permanent
VITE_INSTANCE_MODE=permanent

# Anulación explícita booleana opcional del archivo histórico ('true' | 'false'):
# HISTORICAL_ARCHIVE_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Base de Datos Relacional (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Cadena de conexión para Drizzle ORM y migraciones SQL.
# Formato: mysql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# Ejemplo VPS local:
DATABASE_URL=mysql://ies11_user:Cambiar_Password_Segura_BD_2026@localhost:3306/test_vocacional_ies11

# ------------------------------------------------------------------------------
# 3. Seguridad, Autenticación y Criptografía (OBLIGATORIAS EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Clave criptográfica secreta de alta entropía para firma de tokens JWT (sesiones)
# y firma HMAC (desafíos criptográficos anti-CSRF / reset).
# Generar una clave robusta en terminal con: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_secreto_aleatorio_y_seguro_minimo_32_caracteres

# Contraseña maestra de coordinación para acciones protegidas (exportación de CSV,
# eliminación de registros y reinicios administrativos).
ADMIN_ACTION_PASSWORD=cambiar_por_una_contrasena_de_coordinacion_muy_robusta

# Usuario y contraseña para el sembrado inicial del primer administrador en la base de datos.
# Si ADMIN_INITIAL_PASSWORD no se define, el sistema usa ADMIN_ACTION_PASSWORD.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=cambiar_por_una_contrasena_inicial_segura

# ------------------------------------------------------------------------------
# 4. Configuración del Servidor y Red (Node.js / Express)
# ------------------------------------------------------------------------------
# Entorno de ejecución: 'production' | 'development' | 'test'
NODE_ENV=production

# Puerto TCP en el que escucha el servicio Node.js (por defecto 3000)
PORT=3000

# URL canónica pública del aplicativo (usada para CORS, enlaces y códigos QR)
APP_URL=https://testvocacional.ies11.edu.ar

# Orígenes permitidos para CORS (separados por coma si hay múltiples dominios)
ALLOWED_ORIGINS=https://testvocacional.ies11.edu.ar,https://ies11.edu.ar
